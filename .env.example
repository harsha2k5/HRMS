# ==========================================================
# HRMS ENVIRONMENT CONFIGURATION
# ==========================================================

# Application Settings
APP_NAME="Apex Global HRMS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
SESSION_SECRET="apex_hrms_super_secret_session_token_key_2026"

# Database Configuration (MySQL 8+ / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrms_db
DB_USER=root
DB_PASSWORD=

# SQLite fallback path (used automatically if MySQL is unavailable)
SQLITE_PATH=database/hrms.sqlite

# Company Work Configuration
WORK_START_TIME="09:00"
WORK_END_TIME="18:00"
TIMEZONE="America/New_York"
